    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u3007\u6F14\u8005-\u89B3\u5BA2\u9593\u9045\u5EF6\u8A08\u7B97\u51E6\u7406\r\n\u3000\u2192
    \u73FE\u5728\u5BFE\u5FDC\u3059\u308B\u6F14\u8005\u3068\u6F14\u51FA\u304C\u63C3\u308F\u306A\u3044\u305F\u3081\u691C\u8A3C\u3067\u304D\u307E\u305B\u3093\r\n\t\t\u3007\u89B3\u5BA2\u304B\u3089\u898B\u3066\u6F14\u8005\u306E\u30D1\u30D5\u30A9\u30FC\u30DE\u30F3\u30B9\u304C\u6F14\u51FA\u3068\u305A\u308C\u3066\u3044\u306A\u3044\u304B\r\n\t\t\t\u3007\u9045\u5EF6\u306E\u5927\u304D\u3044\u6F14\u8005\u3067\u691C\u8A3C\r\n\t\t\t\u3007\u9045\u5EF6\u306E\u5927\u304D\u3044\u89B3\u5BA2\u3067\u691C\u8A3C\r\n\t\t\u3000\u3000\u3007\u8907\u6570\u306E\u6F14\u8005\u304C\u540C\u6642\u306B\u30D1\u30D5\u30A9\u30FC\u30DE\u30F3\u30B9\u3059\u308B\u969B\u306B\u89B3\u5BA2\u304B\u3089\u898B\u3066\u30BF\u30A4\u30DF\u30F3\u30B0\u306E\u30BA\u30EC\u306F\u7121\u3044\u304B\r\n\t\t\t\u3007\u9045\u5EF6\u306E\u5927\u304D\u3044\u6F14\u8005\u3068\u305D\u3046\u3067\u306A\u3044\u6F14\u8005\u3067\u691C\u8A3C\r\n\t\t\u3000\u3000\u3007\u8907\u6570\u306E\u6F14\u8005\u304C\u5408\u308F\u305B\u3066\u30D1\u30D5\u30A9\u30FC\u30DE\u30F3\u30B9\u3092\u3059\u308B\u305F\u3081\u306B\u3001\u305D\u308C\u305E\u308C\u306E\u9045\u5EF6\u3092\u76F8\u6BBA\u3067\u304D\u3066\u3044\u308B\u304B\u78BA\u8A8D\r\n\u3000\u3000\u3000\u2192
    WIP\r\n\u3007\u30A8\u30E9\u30FC\u51E6\u7406\r\n\t\t\u3007\u30A8\u30E9\u30FC\u304C\u51FA\u305F\u5834\u5408\u306F\u3061\u3083\u3093\u3068\u505C\u6B62\u3057\u3066\u3044\u308B\u304B\uFF1F\r\n\t\t\u3007\u30A8\u30E9\u30FC\u3057\u305F\u4EBA\u6570\u306E\u5272\u5408\u3067\u306E\u52D5\u4F5C\u306F\u6B63\u78BA\u304B\uFF1F\r\n\t\t\t\u300750%\u3092\u5207\u3063\u3066\u518D\u751F\u3055\u308C\u305F\u30B1\u30FC\u30B9\r\n\t\t\t\u300750%\u3092\u4E0A\u56DE\u3063\u3066\u505C\u6B62\u3057\u305F\u30B1\u30FC\u30B9\r\n\t\t\u3007\u6F14\u8005\u304C\u30A8\u30E9\u30FC\u306B\u306A\u3063\u305F\u5834\u5408\u505C\u6B62\u3057\u305F\u304B\uFF1F\r\n\u2611\u52D5\u753B\u306E\u8FFD\u5F93\r\n\t\t\u2611\u958B\u59CB\u4F4D\u7F6E\u8FFD\u5F93\r\n\t\t\u2611\u4E00\u6642\u505C\u6B62\u4F4D\u7F6E\u8FFD\u5F93\r\n\t\t\u2611\u30B7\u30FC\u30AF\u30D0\u30FC\u79FB\u52D5\u4F4D\u7F6E\u8FFD\u5F93\r\n\u3000\u3000\t\u2611\u901F\u5EA6\u5909\u66F4\u8FFD\u5F93"
